# Copy to .env at the repo root and add your key from https://platform.deepseek.com.
# This is the only chat credential the example APIs read (examples/demo_common/host.py):
# the file is read after the environment and the vertical's own .env, DEEPSEEK_API_KEY maps
# onto the variables the model client reads (DeepSeek's Anthropic-compatible base URL
# included), and any inherited ANTHROPIC_API_KEY/AUTH_TOKEN/BASE_URL is dropped first, so
# a shell's exports for other tooling cannot redirect the requests. The SDK consoles and
# the MCP servers read the environment only. Never put a real key in this file.
DEEPSEEK_API_KEY=
# Set DEEPSEEK_BASE_URL only to route through a gateway instead of DeepSeek's endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
