# Copy to .env at the repo root and add your key from https://platform.deepseek.com.
# The example APIs (examples/demo_common/host.py) read this file, after the environment and
# the example's own .env, and map DEEPSEEK_API_KEY onto the variables the model client
# reads (Anthropic-compatible base URL included); the SDK consoles and the MCP servers read
# the environment only. Never put a real key in this file.
DEEPSEEK_API_KEY=
# Set DEEPSEEK_BASE_URL only to route through a gateway instead of DeepSeek's endpoint.
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
